load("@rules_pkg//pkg:install.bzl", "pkg_install")
load("@rules_pkg//pkg:mappings.bzl", "pkg_filegroup")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "README.md",
])

filegroup(
    name = "runtime_data",
    srcs = [
        "//modules/open_space_planning:runtime_data",
        "//modules/planning:runtime_data",
    ],
)

pkg_filegroup(
    name = "package_files",
    srcs = [
        "//modules/local_planning:package_files",
        "//modules/map:package_files",
        "//modules/open_space_planning:package_files",
        "//modules/planning:package_files",
    ],
)

pkg_install(
    name = "install_dir",
    srcs = [":package_files"],
    tags = ["manual"],
)
