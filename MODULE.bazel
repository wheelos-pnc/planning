module(
    name = "wheelos_planning",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "ad_rss_lib", version = "1.1.0.bcr.1")
bazel_dep(name = "adolc", version = "2.7.2.bcr.2")
bazel_dep(name = "boost.filesystem", version = "1.87.0")
bazel_dep(name = "boost.algorithm", version = "1.87.0")
bazel_dep(name = "boost.property_tree", version = "1.87.0")
bazel_dep(name = "boost.geometry", version = "1.87.0")
bazel_dep(name = "boost.math", version = "1.87.0")
bazel_dep(name = "boost.range", version = "1.87.0")
bazel_dep(name = "boost.thread", version = "1.87.0")
bazel_dep(name = "gflags", version = "2.2.2", repo_name = "com_github_gflags_gflags")
bazel_dep(name = "abseil-cpp", version = "20250127.1", repo_name = "com_google_absl")
bazel_dep(name = "googletest", version = "1.17.0", repo_name = "com_google_googletest")
bazel_dep(name = "protobuf", version = "29.0.bcr.1", repo_name = "com_google_protobuf")
bazel_dep(name = "grpc", version = "1.84.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "yaml-cpp", version = "0.8.0", repo_name = "com_github_jbeder_yaml_cpp")
bazel_dep(name = "proj", version = "9.8.0")
bazel_dep(name = "wheelos_core", version = "1.0.6", repo_name = "core")
bazel_dep(name = "eigen", version = "4.0.0-20241125.bcr.2")
bazel_dep(name = "osqp", version = "1.0.0.bcr.2")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "rules_python", version = "0.34.0")
bazel_dep(name = "wheelos_common", version = "0.1.3")
bazel_dep(name = "wheelos_map", version = "0.1.1")
bazel_dep(name = "wheelos_msgs", version = "0.1.6")
bazel_dep(name = "wheelos_routing", version = "0.1.0")
bazel_dep(name = "wheelos_simulation", version = "0.1.0")
bazel_dep(name = "wheelos_world_model", version = "0.1.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(
    name = "cuda",
    toolkit_path = "/usr/local/cuda",
)
use_repo(cuda, "cuda")

libtorch = use_extension("@wheelos_common//third_party/libtorch:extensions.bzl", "libtorch_ext")
use_repo(libtorch, "libtorch_cpu", "libtorch_gpu")

ipopt = use_extension("//third_party/ipopt:extensions.bzl", "ipopt")
use_repo(ipopt, "ipopt")

single_version_override(
    module_name = "rules_pkg",
    patch_strip = 1,
    patches = ["//third_party/rules_pkg:execroot_runfiles.patch"],
    version = "1.3.0",
)
